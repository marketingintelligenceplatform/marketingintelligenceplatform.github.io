# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_API_BASE_URL: The URL of the backend API service (defaults to empty for same-origin proxying)
VITE_API_BASE_URL=""

# CORS_ORIGIN: Public frontend URL allowed to call this backend.
# Example: https://yourusername.github.io
CORS_ORIGIN=""

# PostgreSQL: use DATABASE_URL on Render, or the individual DB_* variables locally.
DATABASE_URL=""
DB_HOST="localhost"
DB_PORT="5432"
DB_NAME="mip"
DB_USER="postgres"
DB_PASSWORD=""
# Set to true only when your database provider requires TLS.
DB_SSL="false"

# Optional local-development override for the three seeded demo accounts.
# Production never creates demo accounts.
DEV_DEMO_PASSWORD=""
